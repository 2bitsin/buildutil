# Underscore-prefixed entries at the root are derived, local working
# state: _build/, _install/, _conanhome/, _pyvenv/, _bdudata/ (the
# buildutil convention; `buildutil clean --nuke` wipes exactly this set).
# Deeper down, _name.hpp is a private header and is tracked.
/_*
/test_package/_*

# conan writes these; buildutil drives cmake directly, and the package
# test builds under test_package/ with conan's own cmake_layout
CMakeUserPresets.json
test_package/build/

# local secrets (CONAN_REMOTE_* etc.), read by buildutil's dotenv
.env

# regenerated by buildutil from the live build state on every configure
/.vscode/c_cpp_properties.json
/.vscode/tasks.json
/.vscode/launch.json
/.clangd

.pytest_cache

# the ./buildutil launcher redirects bytecode caches into _bdudata/, but a
# direct `python3 -m buildutil` run against a vendored copy (.buildutil/)
# would still write them into the tracked tree
__pycache__/
